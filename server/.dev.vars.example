# Copy this file to .dev.vars and fill in the values from the private setup note.
# .dev.vars is git-ignored. Never commit real values.
MONGODB_URI=
GEOAPIFY_KEY=
# Optional backup forecasts, used only when Open-Meteo refuses. Leave a key empty to turn that backup off.
# Visual Crossing (visualcrossing.com, 15 days) is tried first, OpenWeather (openweathermap.org, 5 days) second.
VISUALCROSSING_KEY=
OPENWEATHER_KEY=

# Which forecast to ask: auto (Open-Meteo, then the backups), or one of open-meteo, visualcrossing,
# openweather (to test one on purpose). Leave empty for auto.
WEATHER_PROVIDER=

# Not secret, but the API needs them.
FIREBASE_PROJECT_ID=tripsync-d3e9b
MONGODB_DB=tripsync_dev
