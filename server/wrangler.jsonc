// Cloudflare Worker settings for TripSync. No secrets in this file.
// The Worker serves the built website and forwards /api/* to the API on Render.
// It holds no database link and no API keys.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tripsync",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // The built React app. Cloudflare serves these files directly.
  // Only /api/* runs the Worker code; any other unknown path gets index.html,
  // so refreshing a deep link like /trips/123 still loads the React app.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Free Cron Trigger: every 10 minutes, ping the API so Render does not put it to sleep.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // Turns on Workers Logs (requests, CPU time, keep-awake ping results) in the dashboard.
  "observability": {
    "enabled": true
  },

  "vars": {
    // Where the API runs: the exact address from TripSync's own Render service page.
    // The Worker forwards login tokens to this address, so never guess it:
    // https://tripsync-api.onrender.com (no suffix) belongs to someone else's service.
    // For a local test of the Worker, `npm run preview:worker` overrides it with the local API.
    "API_ORIGIN": "https://tripsync-api-lec8.onrender.com"
  }
}
