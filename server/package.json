{
  "name": "tripsync-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --env-file=.dev.vars src/server.js",
    "start": "node src/server.js",
    "setup-db": "node --env-file=.dev.vars src/scripts/setupIndexes.js",
    "test": "vitest --run --passWithNoTests",
    "preview:worker": "wrangler dev --port 8788 --var API_ORIGIN:http://127.0.0.1:8787",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "express": "5.3.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
