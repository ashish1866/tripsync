{
  "name": "tripsync-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --env-file=.dev.vars src/server.js",
    "start": "node src/server.js",
    "deploy": "wrangler deploy",
    "setup-db": "node --env-file=.dev.vars src/scripts/setupIndexes.js",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "express": "5.3.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
