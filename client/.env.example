# Copy to .env and fill in from the private setup note (Firebase web config).
# Everything starting with VITE_ is bundled into the browser, so it is public by design.
# Never put a secret here (no MongoDB link, no Geoapify key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
